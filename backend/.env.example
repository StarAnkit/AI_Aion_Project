AI_AION_ENVIRONMENT=development
AI_AION_API_V1_PREFIX=/api/v1
# Required only for database commands and database-backed features.
# Add a local PostgreSQL 17 SQLAlchemy URL in your uncommitted .env file.
AI_AION_DATABASE_URL=
# Optional. Keep the real value only in backend/.env or your runtime secret store.
AI_AION_OPENAI_API_KEY=
AI_AION_OPENAI_MODEL=gpt-5.6
# Comma-delimited host list parsed by pydantic-settings; keep provider-owned hosts only.
AI_AION_OPENAI_IMAGE_HOSTS=openaccess-cdn.clevelandart.org
